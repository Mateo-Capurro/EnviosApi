# Copiá este archivo como .env y completá los valores (.env no se versiona).

# Contraseña del usuario sa: mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos.
# Evitá ';' y '$' porque rompen la cadena de conexión o la interpolación de Compose.
SA_PASSWORD=CambiarPorUnaPasswordFuerte1-

# Clave HMAC para firmar los JWT: al menos 32 bytes (recomendado 48+ caracteres aleatorios).
JWT_KEY=CambiarPorUnaClaveAleatoriaDeAlMenos48CaracteresXXXXXXXXXXXX
